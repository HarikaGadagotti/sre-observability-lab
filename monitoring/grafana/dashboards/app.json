{
  "title": "orders-service - RED metrics",
  "uid": "orders-red",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Request rate (req/s)", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "targets": [{"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "req/s"}]},
    {"id": 2, "type": "timeseries", "title": "Error ratio (5xx)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
     "targets": [{"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) / sum(rate(http_requests_total[1m]))", "legendFormat": "error ratio"}]},
    {"id": 3, "type": "timeseries", "title": "Latency p50 / p95 / p99", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "targets": [
       {"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p50"},
       {"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p95"},
       {"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le))", "legendFormat": "p99"}]},
    {"id": 4, "type": "stat", "title": "In-flight requests", "gridPos": {"x": 12, "y": 8, "w": 6, "h": 8},
     "targets": [{"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "sum(http_requests_in_flight)"}]},
    {"id": 5, "type": "stat", "title": "Availability (last 15m)", "gridPos": {"x": 18, "y": 8, "w": 6, "h": 8},
     "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
     "targets": [{"datasource": {"type": "prometheus", "uid": "prom"}, "expr": "1 - (sum(increase(http_requests_total{status=~\"5..\"}[15m])) / sum(increase(http_requests_total[15m])))"}]}
  ]
}
